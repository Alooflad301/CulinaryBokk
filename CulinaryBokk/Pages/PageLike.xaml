<Page x:Class="CulinaryBokk.Pages.PageLike"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="❤️ Мои избранные рецепты" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,20,0,10"
                   Foreground="White"/>

        <!-- Список избранных -->
        <ListView Grid.Row="1" x:Name="listProduct" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding CurrentPhoto}" 
                                   Stretch="UniformToFill" 
                                   Width="140" Height="140"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding RecipeName}" 
                                          FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Categories.CategoryName}" 
                                          Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Description}" 
                                          TextWrapping="Wrap" MaxHeight="60"/>
                                <TextBlock Text="{Binding Authors.AuthorName}" 
                                          Foreground="Blue" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Кнопка удаления из избранного -->
                            <Button Grid.Column="2" Content="💔 Удалить" 
                                    Background="#FF4444" Foreground="White"
                                    Height="35" Margin="5,50,5,0"
                                    FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Счетчик -->
        <TextBlock x:Name="tbCounter" Grid.Row="2" 
                   HorizontalAlignment="Center" 
                   Margin="0,10" FontSize="16" 
                   Foreground="White"/>

        <!-- Кнопка назад -->
        <Button Content="← Назад к рецептам" Grid.Row="2" 
                HorizontalAlignment="Left" Margin="20,10"
               Height="40"/>
    </Grid>
</Page>
