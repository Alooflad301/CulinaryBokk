<Page x:Class="CulinaryBokk.Pages.AddRecipes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CulinaryBokk.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddRecipes">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF524FC7"/>
                <GradientStop Color="#FFEFFBF6" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Label HorizontalAlignment="Center" Margin="0,37,0,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left"  Margin="264,24,0,0" TextWrapping="Wrap" Text="Добавления данных" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="22" Foreground="Red" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="255,64,0,0" TextWrapping="Wrap" Text="Введите название рецепта" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="16" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Left" Margin="255,116,0,0" TextWrapping="Wrap" Text="Введите описание рецепта" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Left" Margin="247,194,0,0" TextWrapping="Wrap" Text="Выберите категорию рецепта" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="16" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Left" Margin="300,241,0,0" TextWrapping="Wrap" Text="Веберите автора" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Left" Margin="240,286,0,0" TextWrapping="Wrap" Text="Ведите время приготовления" VerticalAlignment="Top" Foreground="Red" FontFamily="Segoe Script" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="290,325,0,0" TextWrapping="Wrap" Text="Введите картинку" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="16" Foreground="Red"/>
        <TextBox x:Name="NameRecepis" Text="{Binding RecipeName}" HorizontalAlignment="Left" Margin="249,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="253"/>
        <TextBox x:Name="DescRecipes" Text="{Binding Description}" HorizontalAlignment="Left" Margin="249,141,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="253" Height="56"/>
        <TextBox x:Name="TextTime" Text="{Binding CookingTime}" HorizontalAlignment="Left" Margin="249,310,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="253"/>
        <TextBox x:Name="TextPage" Text="{Binding image}" HorizontalAlignment="Left" Margin="249,352,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="253"/>
        <ComboBox x:Name="CategoryCombo" SelectedIndex="{Binding CategoryID}" HorizontalAlignment="Left" Margin="249,219,0,0" VerticalAlignment="Top" Width="253"/>
        <ComboBox x:Name="AuyhorCombo" SelectedIndex="{Binding AuthorID}" HorizontalAlignment="Left" Margin="249,267,0,0" VerticalAlignment="Top" Width="253"/>
        <Button x:Name="AddRecep" Content="Добавить" HorizontalAlignment="Left" Margin="266,377,0,0" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="16" Width="117" Click="AddRecep_Click"/>
        <Button x:Name="HomeWorld" Content="К рицептам" HorizontalAlignment="Left" Margin="266,411,0,0" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="16" Click="HomeWorld_Click"/>
        <Button x:Name="LoadImage" Content="Загрузить фото" HorizontalAlignment="Left" Margin="387,395,0,0" VerticalAlignment="Top" Height="25" FontFamily="Segoe Script" Click="LoadImage_Click"/>
        <Image x:Name="pictureBox" HorizontalAlignment="Left" Height="203" Margin="531,116,0,0" VerticalAlignment="Top" Width="217"/>

    </Grid>
</Page>
