<Page x:Class="CulinaryBokk.Pages.PageReg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CulinaryBokk.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageReg">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF42442E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Регистрация" VerticalAlignment="Top" Foreground="Red" FontFamily="Segoe Script" FontSize="22"/>
        <TextBlock HorizontalAlignment="Left" Margin="286,37,0,0" TextWrapping="Wrap" Text="Введите имя автора" VerticalAlignment="Top" Foreground="Red" FontSize="16" FontFamily="Segoe Script"/>
        <TextBlock HorizontalAlignment="Left" Margin="286,90,0,0" TextWrapping="Wrap" Text="Введите логин" VerticalAlignment="Top" FontFamily="Segoe Script" FontSize="18" Foreground="#FFFF0303"/>
        <TextBlock HorizontalAlignment="Left" Margin="286,152,0,0" TextWrapping="Wrap" Text="Введите пароль" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe Script" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,205,0,0" TextWrapping="Wrap" Text="Введите пароль повторно" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red"/>
        <TextBlock HorizontalAlignment="Left" Margin="286,254,0,0" TextWrapping="Wrap" Text="Дата рождения" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="#FFFF0606"/>
        <TextBlock HorizontalAlignment="Left" Margin="449,253,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red"><Run Language="ru-ru" Text="Стаж"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="286,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red" Text="Введите почту"/>
        <TextBox x:Name="TextName" HorizontalAlignment="Left" Margin="286,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235" Height="20"/>
        <TextBox x:Name="TextLogin" HorizontalAlignment="Left" Margin="286,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235" Height="22" TextChanged="TextLogin_TextChanged"/>
        <TextBox x:Name="TextStag" HorizontalAlignment="Left" Margin="449,278,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="72" Height="25"/>
        <TextBox x:Name="TextEmali" HorizontalAlignment="Left" Margin="286,328,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235"/>
        <TextBox x:Name="TextFon" HorizontalAlignment="Left" Margin="287,372,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235"/>
        <DatePicker x:Name="Bid" HorizontalAlignment="Left" Margin="286,279,0,0" VerticalAlignment="Top" Width="151"/>
        <Button x:Name="btnReg" Content="Зарегестрировать" HorizontalAlignment="Left" Margin="287,393,0,0" VerticalAlignment="Top" Width="233" FontFamily="Segoe Script" Click="Button_Click_1"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="287,420,0,0" VerticalAlignment="Top" Width="235" FontFamily="Segoe Script" Click="Button_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="286,346,0,0" TextWrapping="Wrap" Text="Введите телефон" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe Script" Foreground="Red"/>
        <PasswordBox x:Name="TextPassword" HorizontalAlignment="Left" Margin="285,187,0,0" VerticalAlignment="Top" Width="235" PasswordChanged="TextPassword_PasswordChanged"/>
        <PasswordBox x:Name="TextPasswordd" HorizontalAlignment="Left" Margin="282,236,0,0" VerticalAlignment="Top" Width="240"/>

    </Grid>
</Page>
