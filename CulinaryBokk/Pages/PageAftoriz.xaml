<Page x:Class="CulinaryBokk.Pages.PageAftoriz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CulinaryBokk.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="PageAftoriz" Width="800">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF1185B7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Center" Margin="29,162,0,0" TextWrapping="Wrap" Text="Введите логин" VerticalAlignment="Top" Height="42" Width="228" Foreground="Red" FontSize="24" FontFamily="Segoe Script"/>
        <TextBox x:Name="TextLogin" HorizontalAlignment="Center" Margin="27,204,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" Height="31" RenderTransformOrigin="0.501,0.536"/>
        <PasswordBox x:Name="TextPassword" HorizontalAlignment="Center" Margin="29,270,0,0" VerticalAlignment="Top" Width="228" Height="32"/>
        <Button Content="Войти" HorizontalAlignment="Center" Margin="28,310,0,0" VerticalAlignment="Top" Height="45" Width="229" FontFamily="Segoe Script" FontSize="24" Background="White" Click="Button_Click"/>
        <Button Content="Зарегестрироваться" HorizontalAlignment="Center" Margin="28,360,0,0" VerticalAlignment="Top" Height="73" Width="229" FontFamily="Segoe Script" FontSize="22" Click="Button_Click_1"/>
        <TextBlock HorizontalAlignment="Center" Margin="27,237,0,0" TextWrapping="Wrap" Text="Введите пороль" VerticalAlignment="Top" Foreground="#FFFF0101" Height="48" Width="228" FontSize="24" FontFamily="Segoe Script"/>
        <Image Margin="300,10,284,297" Source="/vecteezy_fried-chicken-png-graphic-clipart-design_19607570.png" Stretch="Fill"/>

    </Grid>
</Page>
